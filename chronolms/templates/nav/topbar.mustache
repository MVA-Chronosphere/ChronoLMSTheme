{{!
    Topbar template for ChronoLMS.

    @template theme_chronolms/nav/topbar
    @copyright 2026 Chronosphere Academy
    @license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<header class="chronolms-topbar" role="banner">

    {{! Sidebar toggle button }}
    <button class="sidebar-toggle-btn" id="sidebar-toggle-btn" aria-label="Toggle navigation" aria-expanded="true" aria-controls="chronolms-sidebar">
        <svg width="20" height="20" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    {{! Search bar }}
    <form class="topbar-search" role="search" action="{{searchurl}}" method="get">
        <span class="search-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </span>
        <input type="search" name="q" placeholder="Search courses, lessons, or topics..." aria-label="Search ChronoLMS" id="topbar-search-input">
    </form>

    <div class="topbar-spacer"></div>

    {{! Edit mode switch for Teachers and Admins }}
    {{#editswitch}}
    <div class="topbar-editswitch-container">
        {{{editswitch}}}
    </div>
    {{/editswitch}}

    {{! Action icons }}
    <div class="topbar-actions">

        {{! Notifications }}
        <a href="{{notifurl}}" class="topbar-icon-btn" aria-label="Notifications{{#notifcount}}, {{notifcount}} unread{{/notifcount}}" id="topbar-notif-btn" title="Notifications">
            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            {{#notifbadge}}<span class="topbar-badge" aria-hidden="true">{{notifbadge}}</span>{{/notifbadge}}
        </a>

        {{! Messages }}
        <a href="{{messagesurl}}" class="topbar-icon-btn" aria-label="Messages{{#msgcount}}, {{msgcount}} unread{{/msgcount}}" title="Messages">
            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {{#msgbadge}}<span class="topbar-badge" aria-hidden="true">{{msgbadge}}</span>{{/msgbadge}}
        </a>

        {{! Site Administration link for Admins }}
        {{#isadmin}}
        <a href="{{adminurl}}" class="topbar-icon-btn topbar-admin-btn" aria-label="Site administration" title="Site administration">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </a>
        {{/isadmin}}

        {{! Direct Log Out button }}
        {{#logouturl}}
        <a href="{{logouturl}}" class="topbar-icon-btn topbar-logout-btn" aria-label="Log Out" title="Log Out">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </a>
        {{/logouturl}}
    </div>

    {{! User section — Render Moodle's native user menu dropdown if available }}
    <div class="topbar-user-section">
        {{#usermenu}}
        <div class="topbar-usermenu-container">
            {{{usermenu}}}
        </div>
        {{/usermenu}}
        {{^usermenu}}
        <a href="{{userprofileurl}}" class="topbar-user" aria-label="Your profile — {{userfullname}}">
            <div class="user-avatar">
                {{{useravatar}}}
            </div>
            <div class="user-meta">
                <div class="user-name">{{userfullname}}</div>
                <div class="user-grade">{{usergrade}}</div>
            </div>
        </a>
        {{/usermenu}}
    </div>

</header>
