{{!
    Course Learning Page Template
    Immersive course player view.
}}
<div class="chrono-learning-view">
    <div class="chrono-learning-header">
        <a href="{{courseurl}}" class="chrono-btn chrono-btn-ghost chrono-btn-sm">
            <i class="fa fa-arrow-left"></i> {{coursename}}
